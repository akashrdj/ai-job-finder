# AI Job Finder & Application Drafter Configuration
# Copy this file to .env and configure your keys

# --- LLM Settings ---
# Choose provider: "gemini", "anthropic", "openai", or "mock" (offline fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_HEAVY=gemini-2.5-pro

# Optional: Anthropic Claude, OpenAI, or OpenRouter keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./job_finder.db

# --- Scheduler Settings ---
# Ingestion poll interval in minutes (default 15 minutes)
INGESTION_INTERVAL_MINUTES=15
MIN_MATCH_SCORE_FOR_DRAFTING=65.0

# --- Two-Speed Pipeline & Volume Caps ---
MAX_DRAFTS_PER_DAY=10
MAX_OUTREACH_PER_DAY=5
DRAFTING_SCHEDULE_HOURS=9,18

# --- Email Notifications (Optional Gmail Alerts) ---
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
ALERT_RECIPIENT_EMAIL=your_email@gmail.com

# --- Cold Outreach: Contact Enrichment APIs (Optional) ---
# Hunter.io — 25 domain searches/month (FREE)
# Sign up: https://hunter.io/users/sign_up
HUNTER_API_KEY=

# Snov.io — 50 credits/month (FREE)
# Sign up: https://snov.io/register
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# --- Job Aggregator APIs (Free Tiers) ---
# JSearch: Aggregates Google for Jobs (LinkedIn, Indeed, Glassdoor, Naukri)
# Get free key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Adzuna: Global job search engine
# Get free keys at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Google Sheets Integration (Optional) ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WEBHOOK_URL=
